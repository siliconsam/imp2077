%begin
  %owninteger result, a=1,b=1,c=1,d=1,e=1,f=1,g=1,h=1,i=1,j=1,k=1,l=1,m=1,n=1,o=1,p=1,q=1,r=1,s=1,t=1,u=1,v=1,w=1,x=1,y=1,z=1
  a = 2
  ! exponents of 1 or 0 are OK:
  %for b = 4, -1, 0 %cycle
    result = a ^^ b
    print string("2^^"); write(b, -1)
    print string(" = "); write(result, -1); newline
  %repeat
  ! so this error report of an illegal exponent of 1 may be mis-reported?
  a = 1; b = 1
  z = h << i
  print string("z = ")
  write(z, -1)
  newline

  y = (a + b - c << d - e)
  print string("y = ")
  write(y, -1)
  newline

  result = a << b << c << (a !! b) + e - f ^^ y ^^ z
  print string("result = ")
  write(result, -1)
  newline
%endofprogram
