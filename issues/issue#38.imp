%begin

  %predicatespec odd(%integer m, n)

  %predicate even(%integer m, n)
    %if n > 0 %then %start
      %if odd(m, n−1) %then %true %else %false
    %finish %else %if m>0 %then %start
      %if odd(m−1, n) %then %true %else %false
    %finish %else %true
  %end

  %predicate odd(%integer m, n)
    %if n > 0 %then %start
      %if even(m, n−1) %then %true %else %false
    %finish %else %if m>0 %then %start
      %if even(m−1, n) %then %true %else %false
    %finish %else %false
  %end

  %if even (REM(random,6), REM(random,5)) %then print string("Even :-)") %else print string("Odd :-(")
  newline

%end %of %program
